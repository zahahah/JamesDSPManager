{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "🚀 Send ZIP to Telegram",
			"type": "shell",
			"command": "./send_test.sh",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
        {
            "label": "Delete All GitHub Releases & Tags",
            "type": "shell",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "windows": {
                // Using xargs (Bash syntax) instead of ForEach-Object because the shell is Git Bash
                "command": "gh release list --limit 1000 --json tagName -q '.[].tagName' | xargs -I {} gh release delete {} --cleanup-tag -y"
            },
            "linux": {
                "command": "gh release list --limit 1000 --json tagName -q '.[].tagName' | xargs -I {} gh release delete {} --cleanup-tag -y"
            },
            "osx": {
                "command": "gh release list --limit 1000 --json tagName -q '.[].tagName' | xargs -I {} gh release delete {} --cleanup-tag -y"
            },
            "problemMatcher": [],
            "detail": "Delete All GitHub Releases & Tags"
        }
	]
}